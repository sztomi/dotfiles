{

    "gitlens.advanced.messages": {
        "suppressFileNotUnderSourceControlWarning": true,
    },
    "window.newWindowDimensions": "maximized",
    "extensions.ignoreRecommendations": true,
    "editor.rulers": [100],
    "gitlens.statusBar.enabled": false,
    "gitlens.settings.mode": "advanced",
    "gitlens.showWelcomeOnInstall": false,
    "gitlens.showWhatsNewAfterUpgrades": false,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "editor.minimap.enabled": false,
    "workbench.sideBar.location": "right",
    "editor.fontFamily": "'BerkeleyMono Nerd Font', 'Berkeley Mono', 'Source Code Pro', 'Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
    "keyboard.dispatch": "keyCode",
    "python.formatting.provider": "black",
    "python.formatting.yapfArgs": [
        "--style='{based_on_style: pep8, indent_width: 2}'"
    ],
    "terminal.integrated.fontFamily": "'SauceCodePro Nerd Font', 'Berkeley Mono', monospace",
    "cmake.configureOnOpen": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "editor.trimAutoWhitespace": false,
    "window.menuBarVisibility": "toggle",
    "window.titleBarStyle": "custom",
    "editor.smoothScrolling": true,
    "python.languageServer": "Default",
    "git.confirmSync": false,
    "workbench.startupEditor": "none",
    "editor.lineNumbers": "relative",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.guides.indentation": false,
    "rust.clippy_preference": "on",
    "rust-analyzer.lens.enable": false,
    "rust-analyzer.inlayHints.lifetimeElisionHints.enable": "skip_trivial",
    "rust-analyzer.checkOnSave.command": "clippy",
    "python.analysis.autoImportCompletions": false,
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "*.mutable": {
                "underline": false,
            }
        }
    },
    "workbench.colorTheme": "Dayfox",
    "editor.bracketPairColorization.enabled": false,
    "editor.guides.bracketPairsHorizontal": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "editor.inlineSuggest.enabled": true,
    "vim.handleKeys": {
        "<C-d>": true,
        "<C-s>": false,
        "<C-z>": false,
        "<C-S+O>": false
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "yaml": true,
        "python": false
    },
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "cmake.autoSelectActiveFolder": false,
    "cmake.configureOnEdit": false,
    "cmake.useCMakePresets": "always",
    "cmake.allowUnsupportedPresetsVersions": true,
    "cmake.allowCommentsInPresetsFile": true,
    "markdown-preview-enhanced.liveUpdate": false,
    "editor.tabSize": 2,
    "security.workspace.trust.untrustedFiles": "open",
    "editor.fontSize": 13,
    "editor.lightbulb.enabled": "onCode",
    "reflowMarkdown.preferredLineLength": 99,
    "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "always",
    "rust-analyzer.inlayHints.closureCaptureHints.enable": true,
    "editor.renderFinalNewline": "dimmed",
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.disableAIFeatures": true,
    "claudeCode.useTerminal": true,
    "chat.useClaudeHooks": true,
    "claudeCode.preferredLocation": "sidebar",
    "gitlens.mode.active": "zen",
    "claudeCode.hideOnboarding": true,
}