snippet #!
	#!/usr/bin/env python3
snippet #!3
	#!/usr/bin/env python3
snippet imp
	import ${0:module}
snippet main
    if __name__ == "__main__":
        from argparse import ArgumentParser
        parser = ArgumentParser()
        args = parser.parse_args()
snippet snoop
	import snoop
	@snoop.snoop()
snippet from
	from ${1:package} import ${0:module}
snippet imp
	import ${1:module}
snippet prop
	@property
	def ${1:name}(self):
		return ${2}
snippet addarg
    parser.add_argument("${1:argument}", help="${2:help}")
