# Machine-specific settings (e.g. IdentityAgent for 1Password) live in the
# untracked ~/.ssh/config.local. Avoid Match exec for them: WezTerm's ssh
# client applies Match exec blocks unconditionally.
Include config.local

# home

Host mamut
  User tamas

Host gummy
  HostName gummy.local

Host winvm
  HostName 192.168.124.69
  User tamas

# winvm lives on mamut's private libvirt network; elsewhere, go through mamut.
Match originalhost winvm exec "test $(hostname -s) != mamut"
  ProxyJump mamut

Host steamdeck
  HostName 192.168.144.15
  User deck

Host visionfive2
  HostName 192.168.144.16
  User user

