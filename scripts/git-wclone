#!/usr/bin/env bash
# Clone a repo as: <dir>/.bare (bare clone), <dir>/.git (pointer file),
# <dir>/<default-branch> (worktree). Usage: git wclone <url> [dir]
set -euo pipefail

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "usage: git wclone <url> [dir]" >&2
    exit 1
fi

url=$1
dir=${2:-$(basename "${url%/}" .git)}

if [ -e "$dir" ]; then
    echo "error: '$dir' already exists" >&2
    exit 1
fi

mkdir -p "$dir"
cd "$dir"

git clone --bare "$url" .bare
echo "gitdir: ./.bare" > .git

# Bare clones don't set a fetch refspec, so remote branches would never update.
git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
git fetch origin

# HEAD of the bare clone points at the remote's default branch.
branch=$(git symbolic-ref --short HEAD)
git worktree add "$branch" "$branch"
git -C "$branch" branch --set-upstream-to="origin/$branch"

echo "Ready: $PWD/$branch"
